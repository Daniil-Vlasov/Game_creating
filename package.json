{
  "name": "fantasy-card-trail",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sim": "esbuild scripts/simulate.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.sim/simulate.mjs && node .sim/simulate.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  }
}
